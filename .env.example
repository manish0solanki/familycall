# Copy to .env.local and fill in. Without the Supabase values the app still runs,
# but calls only connect between tabs of the same browser (good for local testing).

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional TURN relay (Phase 4). Comma-separated URLs.
# VITE_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# VITE_TURN_USERNAME=
# VITE_TURN_CREDENTIAL=
